{
  "name": "Shipment",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Reference to order"
    },
    "tracking_number": {
      "type": "string",
      "description": "Courier tracking number"
    },
    "courier": {
      "type": "string",
      "enum": [
        "poslaju",
        "jt_express",
        "ninja_van",
        "dhl",
        "fedex",
        "citylink",
        "gdex"
      ],
      "description": "Shipping courier"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "label_generated",
        "picked_up",
        "in_transit",
        "out_for_delivery",
        "delivered",
        "failed",
        "returned"
      ],
      "default": "pending"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "shipping_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "weight_kg": {
      "type": "number",
      "description": "Package weight in kg"
    },
    "declared_value": {
      "type": "number",
      "description": "Declared value in MYR"
    },
    "shipping_cost": {
      "type": "number"
    },
    "label_url": {
      "type": "string",
      "description": "URL to shipping label PDF"
    },
    "estimated_delivery": {
      "type": "string",
      "format": "date"
    },
    "actual_delivery": {
      "type": "string",
      "format": "date"
    },
    "tracking_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "shipping_address",
    "city",
    "state",
    "postcode",
    "courier"
  ]
}