{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Reference to Product entity"
    },
    "product_name": {
      "type": "string",
      "description": "Product name for display"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating (1-5)"
    },
    "title": {
      "type": "string",
      "description": "Review title"
    },
    "review_text": {
      "type": "string",
      "description": "Review content"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the reviewer"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the reviewer"
    },
    "verified_purchase": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a verified purchase"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Moderation status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin notes for moderation"
    }
  },
  "required": [
    "product_id",
    "product_name",
    "rating",
    "review_text",
    "user_name"
  ]
}