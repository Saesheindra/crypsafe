{
  "name": "ForumReply",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "description": "Reference to ForumThread"
    },
    "content": {
      "type": "string",
      "description": "Reply content"
    },
    "author_name": {
      "type": "string",
      "description": "Author's name"
    },
    "author_email": {
      "type": "string",
      "description": "Author's email"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "deleted"
      ],
      "default": "pending",
      "description": "Reply status"
    },
    "is_solution": {
      "type": "boolean",
      "default": false,
      "description": "Marked as solution"
    }
  },
  "required": [
    "thread_id",
    "content",
    "author_name"
  ]
}