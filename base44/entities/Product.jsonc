{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "price": {
      "type": "number",
      "description": "Price in MYR"
    },
    "currency": {
      "type": "string",
      "default": "MYR"
    },
    "category": {
      "type": "string",
      "enum": [
        "tangem",
        "ledger",
        "onekey",
        "bundle",
        "accessory",
        "keystone"
      ],
      "description": "Product category"
    },
    "image_url": {
      "type": "string",
      "description": "Product image URL"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Product features"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "Total stock count (for products without variants)"
    },
    "popular": {
      "type": "boolean",
      "default": false
    },
    "coinbase_product_id": {
      "type": "string",
      "description": "Coinbase Commerce checkout ID or product code"
    },
    "has_variants": {
      "type": "boolean",
      "default": false,
      "description": "Whether product has color/size variants"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Variant name (e.g., 'Black', 'Blue')"
          },
          "sku": {
            "type": "string",
            "description": "SKU code"
          },
          "stock": {
            "type": "number",
            "default": 0
          },
          "image_url": {
            "type": "string",
            "description": "Variant-specific image"
          },
          "price": {
            "type": "number",
            "description": "Variant-specific price"
          },
          "description": {
            "type": "string",
            "description": "Variant-specific description"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Variant-specific features"
          },
          "coinbase_product_id": {
            "type": "string",
            "description": "Variant-specific Coinbase Commerce ID"
          }
        }
      },
      "description": "Product variants (colors, sizes, etc)"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ]
}